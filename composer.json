{
    "name": "ecommerce/ecommerce-app",
    "description": "A modular e-commerce platform ",
    "license": "MIT",
    "require": {
        "vlucas/phpdotenv": "^5.6"
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
    ,
    "scripts": {
    "test": "vendor/bin/phpunit --configuration phpunit.xml",
    "test:unit": "vendor/bin/phpunit --configuration phpunit.xml --testsuite \"Unit Tests\"",
    "test:integration": "vendor/bin/phpunit --configuration phpunit.xml --testsuite \"Integration Tests\""
    }
}